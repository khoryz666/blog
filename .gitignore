# Hugo output (`hugo build`, `nix build`)
/public/
/resources/
.hugo_build.lock
/result

# Editor files
.vscode/
.idea/
.DS_Store
*.sw?

# Nix / direnv
.direnv

# Obsidian: keep the vault settings and the Git plugin the blog relies on,
# not per-device state.
.obsidian/*
!.obsidian/app.json
!.obsidian/core-plugins.json
!.obsidian/templates.json
!.obsidian/community-plugins.json
!.obsidian/plugins/
