# Hugo output (`hugo build`, `nix build`)
/public/
/resources/
.hugo_build.lock
/result

# Editor files
.vscode/
.idea/
.DS_Store
*.sw?

# Nix / direnv
.direnv

# Obsidian: keep the vault settings the blog relies on (links, attachments,
# templates, git), not per-device state or plugin code.
.obsidian/*
!.obsidian/app.json
!.obsidian/core-plugins.json
!.obsidian/templates.json
!.obsidian/community-plugins.json
!.obsidian/plugins/
.obsidian/plugins/*
!.obsidian/plugins/obsidian-git/
.obsidian/plugins/obsidian-git/*
!.obsidian/plugins/obsidian-git/data.json
