---
import type { CollectionEntry } from 'astro:content'
import Icon from './Icon.astro'

type Post = CollectionEntry<'posts'>

interface Props {
  older: Post | null
  newer: Post | null
}

const { older, newer } = Astro.props
---

<nav class="prev-next-post" aria-label="More posts">
  {older && (
    <a class="pn-link older" href={`/post/${older.id}/`}>
      <Icon name="chevron-left" />
      <span class="pn-text">
        <span class="pn-label">Older post</span>
        <span class="pn-title">{older.data.title}</span>
      </span>
    </a>
  )}
  {newer && (
    <a class="pn-link newer" href={`/post/${newer.id}/`}>
      <Icon name="chevron-right" />
      <span class="pn-text">
        <span class="pn-label">Newer post</span>
        <span class="pn-title">{newer.data.title}</span>
      </span>
    </a>
  )}
</nav>
