---
import { site } from '../config'
import SiteHeader from '../components/SiteHeader.astro'
import Sidebar from '../components/Sidebar.astro'
import Icon from '../components/Icon.astro'
import '../styles/base.css'
import '../styles/layout.css'
import '../styles/sidebar.css'
import '../styles/posts.css'
// Self-hosted variable fonts (no third-party, render-blocking CSS).
import '@fontsource-variable/nunito'
import '@fontsource-variable/cuprum'

interface Props {
  title?: string
  subtitle?: string | string[]
  docTitle?: string
  description?: string
  date?: Date
  lastmod?: Date
  image?: string
  lang?: string
  noindex?: boolean
}

const { title, subtitle, docTitle, description, date, lastmod, image, lang, noindex } = Astro.props
const headerTitle = title ?? site.title
const pageTitle = title ? `${docTitle ?? title} · ${site.title}` : (docTitle ?? site.title)
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
const shareImage = new URL(image ?? '/og-cover.png', Astro.site ?? Astro.url.origin)
const ogType = date ? 'article' : 'website'
---

<!doctype html>
<html lang={lang ?? site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" />
    <title>{pageTitle}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.title} — RSS`}
      href="/rss.xml"
    />
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    {description && <meta property="og:description" content={description} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={shareImage} />
    <meta property="og:image" content={shareImage} />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    {lastmod && <meta property="article:modified_time" content={lastmod.toISOString()} />}
    <script is:inline>
      ;(function () {
        var theme = localStorage.getItem('theme')
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        }
        document.documentElement.dataset.theme = theme
        if (localStorage.getItem('sidebar') === 'hidden') {
          document.documentElement.classList.add('menu-hidden')
        }
      })()
    </script>
  </head>
  <body>
    <button
      id="theme-toggle"
      class="theme-knob"
      type="button"
      aria-label="Toggle dark mode"
      aria-pressed="false"
    >
      <Icon name="moon" class="icon-moon" />
      <Icon name="sun" class="icon-sun" />
    </button>
    <div id="layout">
      <a href="#menu" id="menuLink" class="menu-link" aria-label="Toggle menu" aria-controls="menu" aria-expanded="true">
        <span></span>
      </a>
      <Sidebar pathname={Astro.url.pathname} />
      <div id="main">
        {(title || subtitle) && <SiteHeader title={headerTitle} subtitle={subtitle} />}
        <div class="content">
          <slot />
        </div>
      </div>
    </div>
    <script>
      // Browser chrome color follows the theme's own --bg token, so the value
      // is never duplicated here.
      const syncThemeColor = () => {
        const color = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim()
        const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')
        if (meta && color) meta.content = color
      }
      syncThemeColor()
      window.addEventListener('load', syncThemeColor)

      const menuLink = document.getElementById('menuLink')
      const layout = document.getElementById('layout')

      // The sidebar is a slide-over on narrow screens and collapsible on wide
      // ones, so the reported state has to follow both.
      const syncMenuToggle = () => {
        const shown = window.matchMedia('(max-width: 48em)').matches
          ? Boolean(layout?.classList.contains('active'))
          : !document.documentElement.classList.contains('menu-hidden')
        menuLink?.setAttribute('aria-expanded', String(shown))
      }
      syncMenuToggle()
      window.addEventListener('resize', syncMenuToggle)

      menuLink?.addEventListener('click', (event) => {
        event.preventDefault()
        if (window.matchMedia('(max-width: 48em)').matches) {
          layout?.classList.toggle('active')
        } else {
          const hidden = document.documentElement.classList.toggle('menu-hidden')
          localStorage.setItem('sidebar', hidden ? 'hidden' : 'shown')
        }
        syncMenuToggle()
      })

      const knob = document.getElementById('theme-toggle')
      const syncThemePressed = () =>
        knob?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'))
      syncThemePressed()

      knob?.addEventListener('click', () => {
        const root = document.documentElement
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
        root.dataset.theme = next
        localStorage.setItem('theme', next)
        syncThemeColor()
        syncThemePressed()
      })
    </script>
  </body>
</html>
