---
import BaseLayout from '../layouts/BaseLayout.astro'
import { site } from '../config'
import { getPublishedPosts, toListRows } from '../lib/posts'
import { listHtml } from '../lib/list'

const rows = toListRows(await getPublishedPosts())
---

<BaseLayout subtitle={site.taglines} description={site.taglines[0]}>
  <input
    class="search-input"
    type="search"
    id="post-search"
    placeholder="Search posts..."
    aria-label="Search posts"
  />
  <div id="post-list" set:html={listHtml(rows)} />
</BaseLayout>

<script>
  import { listHtml, type ListRow } from '../lib/list'

  interface SearchEntry extends ListRow {
    tags: string[]
    body: string
  }

  const list = document.getElementById('post-list')
  const input = document.getElementById('post-search') as HTMLInputElement | null

  const render = (entries: SearchEntry[]) => {
    if (!list) return
    list.innerHTML = entries.length === 0 ? '<p>No posts found.</p>' : listHtml(entries)
  }

  // The SSR list stays on screen until the first keystroke: the search index
  // is fetched only then, and reused afterwards.
  let pending: Promise<SearchEntry[]> | null = null
  const loadIndex = () =>
    (pending ??= fetch('/posts.json').then((res) => res.json() as Promise<SearchEntry[]>))

  const matches = (post: SearchEntry, query: string) =>
    [post.title, post.description, post.tags.join(' '), post.body]
      .join(' ')
      .toLowerCase()
      .includes(query)

  const search = async () => {
    const query = input?.value.trim().toLowerCase() ?? ''
    if (!query) {
      if (pending) render(await pending) // back to the full list
      return
    }
    const index = await loadIndex()
    if ((input?.value.trim().toLowerCase() ?? '') !== query) return // input moved on
    render(index.filter((post) => matches(post, query)))
  }

  let debounce: ReturnType<typeof setTimeout> | undefined
  input?.addEventListener('input', () => {
    clearTimeout(debounce)
    debounce = setTimeout(search, 120)
  })
</script>
