---
import BaseLayout from '../layouts/BaseLayout.astro'
import { site } from '../config'
import { getPublishedPosts, toListRows } from '../lib/posts'
import { listHtml } from '../lib/list'

const rows = toListRows(await getPublishedPosts())
---

<BaseLayout subtitle={site.taglines} description={site.taglines[0]}>
  <input
    class="search-input"
    type="search"
    id="post-search"
    placeholder="Search posts..."
    aria-label="Search posts"
  />
  <div id="post-list" set:html={listHtml(rows)} />
</BaseLayout>

<script>
  import { listHtml, type ListRow } from '../lib/list'

  interface SearchEntry extends ListRow {
    tags: string[]
    body: string
  }

  const list = document.getElementById('post-list')
  const input = document.getElementById('post-search') as HTMLInputElement | null

  function render(entries: SearchEntry[]) {
    if (!list) return
    list.innerHTML =
      entries.length === 0 ? '<p>No posts found.</p>' : listHtml(entries)
  }

  let index: SearchEntry[] = []

  fetch('/posts.json')
    .then((response) => response.json() as Promise<SearchEntry[]>)
    .then((data) => {
      index = data
      render(index)
    })

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase()
    const hits = query
      ? index.filter((post) =>
          [post.title, post.description, post.tags.join(' '), post.body]
            .join(' ')
            .toLowerCase()
            .includes(query),
        )
      : index
    render(hits)
  })
</script>
