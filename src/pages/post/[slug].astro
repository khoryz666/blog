---
import { render } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PrevNext from '../../components/PrevNext.astro'
import Icon from '../../components/Icon.astro'
import { getPublishedPosts, postDescription } from '../../lib/posts'
import type { Post } from '../../lib/posts'
import { slugifyTag } from '../../lib/list'
import { readingTime } from '../../lib/markdown'
import { formatDate } from '../../lib/format'

interface Props {
  post: Post
  prev: Post | null
  next: Post | null
}

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts()
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: index + 1 < posts.length ? posts[index + 1] : null,
      next: index - 1 >= 0 ? posts[index - 1] : null,
    } satisfies Props,
  }))
}) satisfies GetStaticPaths

const { post, prev, next } = Astro.props
const { Content } = await render(post)
const description = postDescription(post)
const updated =
  post.data.lastmod && post.data.lastmod.getTime() !== post.data.date.getTime()
    ? post.data.lastmod
    : null
---

<BaseLayout
  title={post.data.title}
  description={description}
  date={post.data.date}
  lastmod={post.data.lastmod}
  image={post.data.image}
  lang={post.data.lang}
>
  {post.data.description && <p class="post-lead">{post.data.description}</p>}
  <div class="post-meta">
    <div class="post-time">
      <Icon name="calendar" class="fa-fw" />
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    </div>
    <div class="post-time">{readingTime(post.body ?? '')}</div>
    {updated && (
      <div class="post-time">
        Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
      </div>
    )}
    {post.data.tags.length > 0 && (
      <ul class="post-tags">
        {post.data.tags.map((tag) => (
          <li>
            <a class="tag-chip" href={`/tags/${slugifyTag(tag)}/`}>#{tag}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
  <Content />
  <PrevNext prev={prev} next={next} />
</BaseLayout>
